# PostgreSQL (used by both the Spring app and Keycloak)
# These values match the defaults in docker-compose.yml.
POSTGRES_USER=shop
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=shop

# Keycloak bootstrap admin (only used on first startup)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_password_here
